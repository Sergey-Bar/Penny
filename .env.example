# Penny - Personal Finance Tracker
# Copy this file to .env and fill in your values.
# This file is committed to git as a template. Never commit .env itself.

# Optional: Override the default host/port for the dev server
# HOST=127.0.0.1
# PORT=3000

# Telegram bot (optional). Get a token from @BotFather and your chat id from @userinfobot.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# CARD_BILLING_DAY=10

# Keep Next.js from sending anonymous build telemetry.
NEXT_TELEMETRY_DISABLED=1

# Use @sergienko4/israeli-bank-scrapers for Isracard and Max (browserless). Off by default:
# on an install that already has Isracard/Max history, rows from the two libraries may not
# deduplicate against each other.
# PENNY_SCRAPER_FORK=1

# Extra host names allowed to reach the app (comma-separated), e.g. a home server name or LAN IP.
# Only localhost is accepted by default, which blocks DNS-rebinding attacks from websites.
# The app listens on 127.0.0.1 only, so this matters behind a reverse proxy or when started with another -H.
# PENNY_ALLOWED_HOSTS=homeserver,192.168.1.20

# Allow an Ollama server on another machine. Off by default so the setting cannot be pointed
# at a foreign server to collect transaction descriptions.
# PENNY_ALLOW_REMOTE_OLLAMA=1

# Update check: a banner in the app (and a Telegram message) when a newer GitHub release exists.
# Only the public release list is read from GitHub; nothing is installed automatically. 0 turns it off.
# PENNY_UPDATE_CHECK=0
# PENNY_UPDATE_REPO=Sergey-Bar/Penny

# Import v2 workbench (per-workspace flag import_v2); 1 forces it on for every workspace.
# PENNY_IMPORT_V2=1

# Durable backend rollout (`backend_v2`): off (default), shadow (inline + audited predictions)
# or on. A workspace setting can override this; see docs/backend-operations.md.
# PENNY_BACKEND_V2=shadow

# Pip v2 (`pip_v2`): off keeps the deterministic ask box, on enables the evidence-first agent.
# A workspace setting can override this. PENNY_PIP_KILL=1 disables chat and briefings everywhere.
# PENNY_PIP_V2=off
# PENNY_PIP_KILL=0
