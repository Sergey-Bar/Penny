{
  "name": "penny",
  "version": "0.5.0",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "demo": "node scripts/demo.mjs",
    "dev:demo": "node scripts/demo.mjs --keep",
    "demo:reset": "node scripts/demo.mjs --reset-only",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 41234",
    "lint": "eslint --max-warnings 0",
    "security:audit": "npm audit --omit=dev",
    "security:audit:gate": "npm audit --omit=dev --audit-level=critical",
    "security:outdated": "npm outdated",
    "docs:screenshots": "node scripts/capture-docs-screenshots.mjs",
    "setup": "node scripts/setup.mjs",
    "backup": "node scripts/backup.mjs",
    "uninstall": "node scripts/uninstall.mjs",
    "service:install": "node scripts/service/install.mjs install",
    "service:uninstall": "node scripts/service/install.mjs uninstall",
    "service:start": "node scripts/service/install.mjs start",
    "service:stop": "node scripts/service/install.mjs stop",
    "service:reload": "npm run build && node scripts/service/install.mjs stop && node scripts/service/install.mjs start",
    "service:status": "node scripts/service/install.mjs status",
    "service:logs": "node scripts/service/install.mjs logs",
    "service:open": "node scripts/service/install.mjs open",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\"",
    "test:security": "vitest run tests/security-headers.test.ts tests/security-policy.test.ts tests/proxy.test.ts tests/host-guard.test.ts tests/lan-access.test.ts tests/user-access.test.ts tests/access-route.test.ts tests/privacy.test.ts",
    "test:contract": "vitest run tests/api-contract.test.ts",
    "test:import": "vitest run tests/import-*.test.ts tests/merchant-dictionary.test.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "knip": "knip",
    "mcp": "node scripts/mcp.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:dev": "electron .",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "@base-ui/react": "^1.9.0",
    "@sergienko4/israeli-bank-scrapers": "10.1.1",
    "@simplewebauthn/server": "14.1.0",
    "@tanstack/react-query": "^5.105.3",
    "better-sqlite3": "13.2.0",
    "boopface": "0.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.9.1",
    "grammy": "1.46.0",
    "israeli-bank-scrapers": "6.13.0",
    "israeli-pension-scrapers": "0.1.0",
    "lucide-react": "^1.68.0",
    "next": "16.4.6",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "puppeteer": "24.43.1",
    "puppeteer-extra": "3.3.6",
    "puppeteer-extra-plugin-stealth": "2.11.2",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^2.2.1"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "fast-check": "^4.11.0",
    "knip": "^6.48.0",
    "prettier": "^3.10.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "@hieutran094/camoufox-js": "0.11.2",
    "playwright-core": "1.64.1",
    "basic-ftp": "6.2.6",
    "chromium-bidi": {
      "zod": "4.6.7"
    }
  },
  "main": "desktop/main.cjs",
  "description": "Penny: private, local-first personal finance for Israel",
  "author": "Penny",
  "allowScripts": {
    "better-sqlite3": false
  }
}
